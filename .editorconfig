# https://editorconfig.org — que cualquier editor respete el mismo formato.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python: cuatro espacios. ruff format manda y no se discute.
[*.py]
indent_style = space
indent_size = 4

[*.{toml,yml,yaml,json,md,sh}]
indent_style = space
indent_size = 2

# En Markdown, dos espacios al final de una línea son un salto: no se borran.
[*.md]
trim_trailing_whitespace = false
